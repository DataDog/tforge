{
  "terraform": {
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "~> 5.0"
      },
      "google": {
        "source": "hashicorp/google",
        "version": "~> 5.0"
      }
    }
  },
  "provider": {
    "aws": [
      {
        "region": "us-east-1"
      },
      {
        "alias": "west",
        "region": "us-west-2"
      }
    ],
    "google": [
      {
        "project": "my-project",
        "region": "us-central1"
      }
    ]
  },
  "resource": {
    "aws_instance": {
      "east": {
        "ami": "ami-east",
        "instance_type": "t3.micro"
      },
      "west": {
        "ami": "ami-west",
        "instance_type": "t3.micro",
        "provider": "aws.west"
      }
    },
    "google_compute_instance": {
      "central": {
        "machine_type": "e2-medium",
        "zone": "us-central1-a"
      }
    }
  }
}
