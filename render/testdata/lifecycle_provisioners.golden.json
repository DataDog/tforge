{
  "terraform": {
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "~> 5.0"
      }
    }
  },
  "provider": {
    "aws": [
      {
        "region": "us-east-1"
      }
    ]
  },
  "resource": {
    "aws_instance": {
      "app": {
        "ami": "ami-abcdef",
        "connection": {
          "host": "${self.public_ip}",
          "private_key": "${file(\"~/.ssh/id_rsa\")}",
          "timeout": "5m",
          "type": "ssh",
          "user": "ubuntu"
        },
        "instance_type": "t3.small",
        "lifecycle": {
          "create_before_destroy": true,
          "prevent_destroy": true,
          "ignore_changes": [
            "tags",
            "ami"
          ],
          "replace_triggered_by": [
            "aws_security_group.main.id"
          ],
          "precondition": {
            "condition": "var.env != \"\"",
            "error_message": "env must not be empty"
          },
          "postcondition": {
            "condition": "self.public_ip != \"\"",
            "error_message": "instance must have a public IP"
          }
        },
        "provisioner": [
          {
            "local-exec": {
              "command": "echo ${self.public_ip} >> hosts.txt"
            }
          },
          {
            "remote-exec": {
              "connection": {
                "host": "${self.private_ip}",
                "port": 2222,
                "type": "ssh",
                "user": "admin"
              },
              "inline": [
                "sudo apt-get update",
                "sudo apt-get install -y nginx"
              ],
              "on_failure": "continue",
              "when": "create"
            }
          }
        ],
        "timeouts": {
          "create": "30m",
          "update": "20m",
          "delete": "15m"
        }
      }
    }
  }
}
