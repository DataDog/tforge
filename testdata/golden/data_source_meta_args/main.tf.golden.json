{
  "//": {
    "metadata": {
      "stackName": "data-source-meta-args-golden",
      "tool": "tforge",
      "version": "dev"
    }
  },
  "terraform": {
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "~> 5.0"
      }
    }
  },
  "provider": {
    "aws": [
      {
        "region": "us-east-1"
      },
      {
        "alias": "west",
        "region": "us-west-2"
      }
    ]
  },
  "data": {
    "aws_ami": {
      "per_region": {
        "for_each": {
          "us-east-1": "ami-east",
          "us-west-2": "ami-west"
        },
        "most_recent": true
      }
    },
    "aws_availability_zones": {
      "counted": {
        "count": 3,
        "state": "available"
      }
    },
    "aws_caller_identity": {
      "current": {
        "depends_on": [
          "data.aws_availability_zones.counted"
        ]
      }
    },
    "aws_subnet": {
      "all_meta": {
        "count": 2,
        "depends_on": [
          "data.aws_vpc.west_vpc"
        ],
        "provider": "aws.west",
        "vpc_id": "${data.aws_vpc.west_vpc.id}"
      }
    },
    "aws_vpc": {
      "west_vpc": {
        "default": true,
        "provider": "aws.west"
      }
    }
  }
}

