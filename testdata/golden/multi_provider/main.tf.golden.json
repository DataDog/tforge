{
  "//": {
    "metadata": {
      "stackName": "multi-provider-golden",
      "tool": "tforge",
      "version": "dev"
    }
  },
  "terraform": {
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "~> 5.0"
      },
      "random": {
        "source": "hashicorp/random",
        "version": "~> 3.5"
      }
    }
  },
  "provider": {
    "aws": [
      {
        "region": "us-east-1"
      },
      {
        "alias": "west",
        "region": "us-west-2"
      }
    ],
    "random": [
      {}
    ]
  },
  "resource": {
    "aws_instance": {
      "east": {
        "//": {
          "metadata": {
            "path": "multi-provider-golden/east",
            "uniqueId": "east"
          }
        },
        "ami": "ami-east-123",
        "depends_on": [
          "random_pet.name"
        ],
        "instance_type": "t3.micro",
        "provider": "aws",
        "tags": {
          "Name": "${random_pet.name.id}-east"
        }
      },
      "west": {
        "//": {
          "metadata": {
            "path": "multi-provider-golden/west",
            "uniqueId": "west"
          }
        },
        "ami": "ami-west-456",
        "count": 3,
        "instance_type": "t3.micro",
        "provider": "aws.west",
        "tags": {
          "Name": "${random_pet.name.id}-west-${count.index}"
        }
      }
    },
    "aws_s3_bucket": {
      "logs": {
        "//": {
          "metadata": {
            "path": "multi-provider-golden/logs",
            "uniqueId": "logs"
          }
        },
        "bucket": "${each.key}-${random_pet.name.id}",
        "for_each": {
          "access-logs": "access-logs",
          "app-logs": "app-logs",
          "audit-logs": "audit-logs"
        },
        "tags": {
          "Purpose": "${each.key}"
        }
      }
    },
    "random_pet": {
      "name": {
        "//": {
          "metadata": {
            "path": "multi-provider-golden/name",
            "uniqueId": "name"
          }
        },
        "length": 2
      }
    }
  },
  "data": {
    "aws_availability_zones": {
      "available": {
        "//": {
          "metadata": {
            "path": "multi-provider-golden/available",
            "uniqueId": "available"
          }
        },
        "provider": "aws.west",
        "state": "available"
      }
    }
  }
}

