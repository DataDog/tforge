		opt(h)
	}
	return h
}

// UsersData represents the datadog_users data source.
// Use this data source to retrieve information about existing users for use in other resources.
type UsersData struct {
	Filter       string           `json:"filter,omitempty"`
	FilterStatus string           `json:"filter_status,omitempty"`
	ID           string           `json:"id,omitempty"`
	Users        []map[string]any `json:"users,omitempty"`
	resource     *config.DataSource
}

type UsersDataOption func(*UsersData)

func UsersData_SetFilter(v string) UsersDataOption {
	return func(o *UsersData) {
		o.Filter = v
	}
}

func UsersData_SetFilterStatus(v string) UsersDataOption {
	return func(o *UsersData) {
		o.FilterStatus = v
	}
}

func UsersData_SetID(v string) UsersDataOption {
	return func(o *UsersData) {
		o.ID = v
	}
}

func UsersData_SetUsers(v []map[string]any) UsersDataOption {
	return func(o *UsersData) {
		o.Users = v
	}
}

func FromUsersData(cfg UsersData) UsersDataOption {
	return func(o *UsersData) {
		save := o.resource
		*o = cfg
		o.resource = save
	}
}

// NewUsersData creates a datadog_users data source, attaches it to the stack, and returns a
// handle whose Configure method sets the data source's attributes.
func NewUsersData(stack *config.Stack, name string) (*UsersData, error) {
	h := &UsersData{}
	h.resource = &config.DataSource{
		Name:            name,
		Type:            "datadog_users",
		TypedAttributes: h,
	}
	if err := stack.AddDataSource(h); err != nil {
		return nil, err
	}
	return h, nil
}

// AsDataSource returns the underlying data source, implementing config.DataSourcer.
func (h *UsersData) AsDataSource() *config.DataSource {
	return h.resource
}

// Configure sets attribute fields on the datadog_users. Safe to call multiple times;
// each call mutates the typed payload in place. Returns the receiver for chaining.
func (h *UsersData) Configure(opts ...UsersDataOption) *UsersData {
	for _, opt := range opts {
		opt(h)
	}
	return h
}
