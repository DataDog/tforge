// NewLogsCustomPipeline creates a datadog_logs_custom_pipeline resource, attaches it to the stack, and returns a
// handle whose Apply method configures the resource's attributes.
func NewLogsCustomPipeline(stack *config.Stack, name string) (*LogsCustomPipeline, error) {
	h := &LogsCustomPipeline{}
	r := &config.Resource{
		Name:            name,
		Type:            "datadog_logs_custom_pipeline",
		TypedAttributes: h,
	}
	if err := stack.AddResourcePtr(r); err != nil {
		return nil, err
	}
	h.resource = r
	return h, nil
}

// Apply sets attribute fields on the datadog_logs_custom_pipeline. Safe to call multiple times;
// each call mutates the typed payload in place. Returns the receiver for chaining.
func (h *LogsCustomPipeline) Apply(opts ...LogsCustomPipelineOption) *LogsCustomPipeline {
	for _, opt := range opts {
		opt(h)
	}
	return h
}

// ApplyResourceOptions sets meta-arguments (Lifecycle, Provider, DependsOn,
// Timeouts) on the underlying resource. Safe to call multiple times.
func (h *LogsCustomPipeline) ApplyResourceOptions(opts ...config.ResourceOption) {
	for _, opt := range opts {
		opt(h.resource)
	}
}

