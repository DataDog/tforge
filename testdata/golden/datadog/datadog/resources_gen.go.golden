// NewMonitor creates a datadog_monitor resource, attaches it to the stack, and returns a
// handle whose Apply method configures the resource's attributes.
func NewMonitor(stack *config.Stack, name string) (*Monitor, error) {
	h := &Monitor{}
	r := &config.Resource{
		Name:            name,
		Type:            "datadog_monitor",
		TypedAttributes: h,
	}
	if err := stack.AddResourcePtr(r); err != nil {
		return nil, err
	}
	h.resource = r
	return h, nil
}

// Apply sets attribute fields on the datadog_monitor. Safe to call multiple times;
// each call mutates the typed payload in place. Returns the receiver for chaining.
func (h *Monitor) Apply(opts ...MonitorOption) *Monitor {
	for _, opt := range opts {
		opt(h)
	}
	return h
}

// ApplyResourceOptions sets meta-arguments (Lifecycle, Provider, DependsOn,
// Timeouts) on the underlying resource. Safe to call multiple times.
func (h *Monitor) ApplyResourceOptions(opts ...config.ResourceOption) {
	for _, opt := range opts {
		opt(h.resource)
	}
}

