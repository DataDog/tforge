// NewSyntheticsTest creates a datadog_synthetics_test resource, attaches it to the stack, and returns a
// handle whose Apply method configures the resource's attributes.
func NewSyntheticsTest(stack *config.Stack, name string) (*SyntheticsTest, error) {
	h := &SyntheticsTest{}
	r := &config.Resource{
		Name:            name,
		Type:            "datadog_synthetics_test",
		TypedAttributes: h,
	}
	if err := stack.AddResourcePtr(r); err != nil {
		return nil, err
	}
	h.resource = r
	return h, nil
}

// Apply sets attribute fields on the datadog_synthetics_test. Safe to call multiple times;
// each call mutates the typed payload in place. Returns the receiver for chaining.
func (h *SyntheticsTest) Apply(opts ...SyntheticsTestOption) *SyntheticsTest {
	for _, opt := range opts {
		opt(h)
	}
	return h
}

// ApplyResourceOptions sets meta-arguments (Lifecycle, Provider, DependsOn,
// Timeouts) on the underlying resource. Safe to call multiple times.
func (h *SyntheticsTest) ApplyResourceOptions(opts ...config.ResourceOption) {
	for _, opt := range opts {
		opt(h.resource)
	}
}

