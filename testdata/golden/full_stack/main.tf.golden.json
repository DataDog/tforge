{
  "terraform": {
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "~> 5.0"
      }
    },
    "backend": {
      "s3": {
        "bucket": "my-terraform-state",
        "dynamodb_table": "terraform-locks",
        "encrypt": true,
        "key": "prod/terraform.tfstate",
        "region": "us-east-1"
      }
    }
  },
  "provider": {
    "aws": [
      {
        "region": "us-east-1"
      }
    ]
  },
  "resource": {
    "aws_instance": {
      "web": {
        "ami": "ami-0c55b159cbfafe1f0",
        "instance_type": "t3.micro",
        "tags": {
          "Environment": "production",
          "Name": "web-server"
        }
      }
    }
  },
  "data": {
    "aws_ami": {
      "ubuntu": {
        "filter": [
          {
            "name": "name",
            "values": [
              "ubuntu/images/hvm-ssd/ubuntu-focal-20.04-amd64-server-*"
            ]
          }
        ],
        "most_recent": true,
        "owners": [
          "099720109477"
        ]
      }
    }
  },
  "variable": {
    "enable_monitoring": {
      "type": "bool",
      "default": true,
      "nullable": true
    },
    "environment": {
      "type": "string",
      "description": "Deployment environment",
      "default": "production",
      "validation": {
        "condition": "length(var.environment) > 0",
        "error_message": "Environment must not be empty."
      }
    }
  },
  "output": {
    "instance_id": {
      "value": "${aws_instance.web.id}",
      "description": "The ID of the web server instance"
    },
    "instance_private_ip": {
      "value": "${aws_instance.web.private_ip}",
      "sensitive": true,
      "depends_on": [
        "aws_instance.web"
      ]
    }
  },
  "locals": {
    "common_tags": {
      "ManagedBy": "tforge",
      "Project": "my-app"
    },
    "project_name": "my-app"
  }
}

